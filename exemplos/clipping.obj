# Objetos que cruzam as bordas da window inicial (0..1000), para testar o clipping.
# Nada deve ser desenhado fora da moldura vermelha da viewport.
mtllib clipping.mtl

o reta_horizontal
v -400 500 0
v 1400 500 0
usemtl vermelho
l 1 2

o reta_vertical
v 500 -400 0
v 500 1400 0
usemtl vermelho
l 3 4

o diagonal_cantos
v -300 -300 0
v 1300 1300 0
